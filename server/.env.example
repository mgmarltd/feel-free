# Calmutopia server environment

# HTTP port
PORT=3900

# ElevenLabs (voice agents + TTS)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Resend (email verification codes) — optional; logs to console if unset
RESEND_API_KEY=
RESEND_FROM=Calmutopia <onboarding@resend.dev>

# Admin dashboard auth
ADMIN_EMAIL=admin@calmutopia.app
ADMIN_PASSWORD=change-me-to-a-strong-password
# Optional: explicit token signing secret (defaults to one derived from the password)
ADMIN_JWT_SECRET=
# Optional: admin token lifetime in hours (default 168 = 7 days)
ADMIN_TOKEN_TTL_H=168
